# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── PostgreSQL Database ──────────────────────────────────────
# Primary connection URL format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_automation
# Or discrete variables (used if DATABASE_URL is not set):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=whatsapp_automation
# DB_USER=postgres
# DB_PASSWORD=
# Connection Pool & Timeouts:
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_CONN_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
# Production TLS: Set to "true" (requires valid CA cert) or "allow-self-signed" (for testing)
# DB_SSL=false

# ─── Session secret ───────────────────────────────────────────
# Used to sign login session cookies. Set a 64+ char random string for production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, one is generated automatically on first run and saved to data/.session_secret.
# IMPORTANT: With multiple instances, each would generate a different secret —
# every restart would log out all users. Set this explicitly in production.
SESSION_SECRET=

# ─── Bootstrap Admin Account ─────────────────────────────────
# If set, this email is promoted to admin on every server startup (idempotent).
# If the account doesn't exist yet, it is created with an unusable placeholder
# password — set a real password via the change-password API after first login.
# Leave empty to manage admins exclusively through the admin panel.
# ⚠️  IMPORTANT FOR TESTING: Do NOT set this in your local .env if you run
# npm test — it will leak into tests and cause ~100 test failures. Use a
# separate .env.production file or set it only in your server's environment.
BOOTSTRAP_ADMIN_EMAIL=

# ─── Gemini AI API Key ────────────────────────────────────────
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Demo Mode ───────────────────────────────────────────────
# Set to "true" to run the dashboard with mock data (no WhatsApp required).
# Set to "false" (default) for production WhatsApp automation.
DEMO_MODE=false

# ─── Allowed cross-origin origins (optional) ───────────────────
# Comma-separated list of allowed origins (e.g. https://app.example.com)
ALLOWED_ORIGINS=

# ─── Reverse Proxy & TLS ──────────────────────────────────────
# Set to "true" when behind Caddy/nginx/Cloudflare
TRUST_PROXY=false
FORCE_HTTPS=false

# ─── Concurrency & Capacity Controls ─────────────────────────
# Max simultaneous WhatsApp Puppeteer/Chrome instances (each ~150-300MB RSS in practice).
# Sizing guide: (total_RAM_GB - 1.5) × 3   (leaves headroom for Node + OS + Caddy)
#   2GB VPS  →  1   (tight — 1 session max)
#   4GB VPS  →  7   (comfortable for small teams)
#   8GB VPS  → 19   (recommended production minimum for 30 users)
#   16GB VPS → 43   (handles 30 simultaneous active sessions with headroom)
# With SESSION_IDLE_TIMEOUT_MS set, idle sessions hibernate their Chrome process,
# so realistic peak is much lower than the total number of registered users.
MAX_CONCURRENT_WHATSAPP_SESSIONS=5

# Max concurrent AI/Gemini requests in-flight (globally across all users and per-user)
MAX_CONCURRENT_AI_JOBS=8
MAX_CONCURRENT_AI_PER_USER=2
GEMINI_TIMEOUT_MS=30000

# Max concurrent bulk outreach campaigns across platform and per user
MAX_CONCURRENT_OUTREACH_JOBS=5
MAX_CONCURRENT_OUTREACH_PER_USER=1
MAX_OUTREACH_RECIPIENTS_PER_JOB=25

# Max SSE event streams (live status & QR code streaming)
MAX_SSE_CLIENTS_PER_USER=5
MAX_SSE_CLIENTS_TOTAL=250

# Restart & Shutdown Timing
RESUME_STAGGER_MS=4000
SHUTDOWN_GRACE_MS=15000

# ─── Password Hashing ─────────────────────────────────────────
# bcrypt work factor. 12 is the production default (recommended).
# Lower values (4) are only for test environments where speed matters.
# Do NOT lower this in production — it directly controls brute-force resistance.
BCRYPT_ROUNDS=12

# ─── Docker Memory Limits (used by docker-compose.prod.yml) ───
# Match to your EC2 instance — leave ~1.5GB for OS + Caddy + headroom.
# See docker-compose.prod.yml for the full sizing table.
MEM_LIMIT=2.5G
SWAP_LIMIT=2.5G

# ─── Google Calendar integration (optional) ─────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

# ─── Product Image Storage & Catalog ──────────────────────────
# Max upload size in megabytes for product images (default: 5, formats: JPEG, PNG, WebP)
PRODUCT_IMAGE_MAX_SIZE_MB=5

